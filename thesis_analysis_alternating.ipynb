{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Vision Transformer Alternating Block Approximation Analysis\n",
    "## Investigating Alternating Layer Approximation Strategy"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from pathlib import Path\n",
    "\n",
    "# Set style\n",
    "sns.set_style('darkgrid')\n",
    "plt.rcParams['figure.figsize'] = (14, 8)\n",
    "\n",
    "# Load data\n",
    "results = pd.read_csv('/Users/mabelwylie/Documents/toast-extensions/results/results_alternating_window_grid_combined.csv')\n",
    "accuracies = pd.read_csv('/Users/mabelwylie/Documents/toast-extensions/skipping_heads/accuracies/accuracies_alternating_window_grid_combined.csv')\n",
    "\n",
    "print(f\"Results shape: {results.shape}\")\n",
    "print(f\"Accuracies shape: {accuracies.shape}\")\n",
    "print(f\"\\nUnique models: {results['model'].nunique()}\")\n",
    "print(f\"Unique datasets: {results['dataset'].nunique()}\")\n",
    "print(f\"Unique translators: {results['translator'].nunique()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Data Preprocessing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Extract model short name\n",
    "results['model_short'] = results['model'].str.split('/').str[-1]\n",
    "\n",
    "# Extract number of approximated layers from approx_layer\n",
    "def parse_approx_layers(s):\n",
    "    if s == '[]' or pd.isna(s):\n",
    "        return 0\n",
    "    try:\n",
    "        import ast\n",
    "        return len(ast.literal_eval(str(s)))\n",
    "    except:\n",
    "        return 0\n",
    "\n",
    "results['num_approx_layers'] = results['approx_layer'].apply(parse_approx_layers)\n",
    "\n",
    "print(\"Processed data:\")\n",
    "print(results[['model_short', 'dataset', 'translator', 'num_approx_layers', 'accuracy', 'params_saved_pct']].head(10))\n",
    "\n",
    "print(f\"\\nNumber of approximated layers distribution:\")\n",
    "print(results[results['translator'] == 'linear']['num_approx_layers'].value_counts().sort_index())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Best Alternating Approximations by Model and Dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Filter only linear approximations (not identity baseline)\n",
    "linear_results = results[results['translator'] == 'linear'].copy()\n",
    "\n",
    "# Group by model, dataset, and approx_layer to get mean across seeds\n",
    "aggregated = linear_results.groupby(['model_short', 'dataset', 'approx_layer']).agg({\n",
    "    'accuracy': 'mean',\n",
    "    'original_accuracy': 'mean',\n",
    "    'delta_acc': ['mean', 'max'],\n",
    "    'params_saved_pct': 'first',\n",
    "    'num_approx_layers': 'first'\n",
    "}).reset_index()\n",
    "\n",
    "# Flatten columns\n",
    "aggregated.columns = ['model_short', 'dataset', 'approx_layer', 'accuracy', 'original_accuracy',\n",
    "                      'delta_mean', 'delta_max', 'params_saved_pct', 'num_approx_layers']\n",
    "\n",
    "# Calculate retention\n",
    "aggregated['accuracy_retention_pct'] = (aggregated['accuracy'] / aggregated['original_accuracy'] * 100).round(2)\n",
    "\n",
    "# Sort by model, dataset, accuracy\n",
    "aggregated = aggregated.sort_values(['model_short', 'dataset', 'accuracy'], ascending=[True, True, False])\n",
    "\n",
    "print(f\"Total alternating approximation experiments: {len(linear_results)}\")\n",
    "print(f\"Total unique configurations: {len(aggregated)}\")\n",
    "print(f\"\\nTop 20 best alternating approximations:\")\n",
    "print(aggregated[[\n",
    "    'model_short', 'dataset', 'approx_layer', 'num_approx_layers',\n",
    "    'accuracy', 'accuracy_retention_pct', 'params_saved_pct'\n",
    ]].head(20).to_string())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Comparison: Alternating vs Single-Layer Approximations"
   ]
  },
  {
   "cell_type": {"cell_type": "markdown", "metadata": {}},
   "source": [
    "Load the single-layer window grid results for comparison"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load window grid results for comparison\n",
    "window_results = pd.read_csv('/Users/mabelwylie/Documents/toast-extensions/results/results_window_grid_combined.csv')\n",
    "window_results['model_short'] = window_results['model'].str.split('/').str[-1]\n",
    "\n",
    "def parse_approx_layers(s):\n",
    "    if s == '[]' or pd.isna(s):\n",
    "        return 0\n",
    "    try:\n",
    "        import ast\n",
    "        return len(ast.literal_eval(str(s)))\n",
    "    except:\n",
    "        return 0\n",
    "\n",
    "window_results['num_approx_layers'] = window_results['approx_layer'].apply(parse_approx_layers)\n",
    "window_linear = window_results[window_results['translator'] == 'linear'].copy()\n",
    "\n",
    "# Group by 2 layers approximated for fair comparison\n",
    "window_2layer = window_linear[window_linear['num_approx_layers'] == 2].groupby(['model_short', 'dataset']).agg({\n",
    "    'accuracy': 'mean',\n",
    "    'original_accuracy': 'mean',\n",
    "    'params_saved_pct': 'mean'\n",
    "}).reset_index()\n",
    "\n",
    "window_2layer.columns = ['model_short', 'dataset', 'accuracy_window', 'original_accuracy', 'params_window']\n",
    "\n",
    "# Get alternating 2-layer approximations\n",
    "alternating_2layer = aggregated[aggregated['num_approx_layers'] == 2].groupby(['model_short', 'dataset']).agg({\n",
    "    'accuracy': 'mean',\n",
    "    'params_saved_pct': 'mean'\n",
    "}).reset_index()\n",
    "\n",
    "alternating_2layer.columns = ['model_short', 'dataset', 'accuracy_alternating', 'params_alternating']\n",
    "\n",
    "# Merge for comparison\n",
    "comparison = window_2layer.merge(alternating_2layer, on=['model_short', 'dataset'], how='outer')\n",
    "comparison['accuracy_diff'] = (comparison['accuracy_alternating'] - comparison['accuracy_window']).round(4)\n",
    "comparison['params_diff'] = (comparison['params_alternating'] - comparison['params_window']).round(2)\n",
    "\n",
    "print(\"\\nComparison: 2-Layer Approximations (Window vs Alternating)\")\n",
    "print(\"=\"*100)\n",
    "print(comparison[['model_short', 'dataset', 'accuracy_window', 'accuracy_alternating', 'accuracy_diff',\n",
    "                  'params_window', 'params_alternating']].to_string())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Accuracy vs Parameters Saved by Number of Layers"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, axes = plt.subplots(1, 3, figsize=(16, 5))\n",
    "\n",
    "for idx, dataset in enumerate(sorted(linear_results['dataset'].unique())):\n",
    "    ax = axes[idx]\n",
    "    dataset_data = aggregated[aggregated['dataset'] == dataset]\n",
    "    \n",
    "    # Plot by number of layers\n",
    "    for num_layers in sorted(dataset_data['num_approx_layers'].unique()):\n",
    "        layer_data = dataset_data[dataset_data['num_approx_layers'] == num_layers]\n",
    "        ax.scatter(layer_data['params_saved_pct'], layer_data['accuracy'],\n",
    "                  label=f'{int(num_layers)} layers', s=100, alpha=0.6)\n",
    "    \n",
    "    ax.set_xlabel('Parameters Saved (%)', fontsize=11)\n",
    "    ax.set_ylabel('Mean Accuracy', fontsize=11)\n",
    "    ax.set_title(f'Dataset: {dataset}', fontsize=12, fontweight='bold')\n",
    "    ax.legend()\n",
    "    ax.grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('/Users/mabelwylie/Documents/toast-extensions/alternating_accuracy_vs_params.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "print(\"Saved to: alternating_accuracy_vs_params.png\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Model Performance Summary"
   ]
  },
  {
   "cell_type": {"cell_type": "code", "execution_count": null, "metadata": {}},
   "source": [
    "model_summary = linear_results.groupby('model_short').agg({\n",
    "    'accuracy': ['mean', 'std', 'min', 'max'],\n",
    "    'delta_acc': ['mean', 'max'],\n",
    "    'params_saved_pct': 'max',\n",
    "    'original_accuracy': 'mean',\n",
    "    'model_short': 'count'\n",
    "}).round(4)\n",
    "\n",
    "model_summary.columns = ['mean_acc', 'std_acc', 'min_acc', 'max_acc',\n",
    "                         'mean_loss', 'max_loss', 'max_params_saved', 'baseline_acc', 'num_experiments']\n",
    "\n",
    "print(\"\\nMODEL SUMMARY (Alternating Approximations):\")\n",
    "print(\"=\"*120)\n",
    "print(model_summary.to_string())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Dataset-Specific Insights"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "dataset_summary = linear_results.groupby('dataset').agg({\n",
    "    'accuracy': ['mean', 'std', 'min', 'max'],\n",
    "    'delta_acc': ['mean', 'max'],\n",
    "    'params_saved_pct': 'mean',\n",
    "    'original_accuracy': 'mean'\n",
    "}).round(4)\n",
    "\n",
    "dataset_summary.columns = ['mean_acc', 'std_acc', 'min_acc', 'max_acc',\n",
    "                           'mean_loss', 'max_loss', 'avg_params_saved', 'baseline_acc']\n",
    "\n",
    "dataset_summary['robustness'] = (dataset_summary['mean_acc'] / dataset_summary['baseline_acc']).round(4)\n",
    "\n",
    "print(\"\\nDATASET SUMMARY (Alternating Approximations):\")\n",
    "print(\"=\"*100)\n",
    "print(dataset_summary.to_string())"
   ]
  },
  {
   "cell_type": {"cell_type": "markdown", "metadata": {}},
   "source": [
